rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role in ['admin', 'superadmin'];
    }

    function isManager() {
      return signedIn() && request.auth.token.role in ['manager', 'admin', 'superadmin'];
    }

    function isOperator() {
      return signedIn() && request.auth.token.role in ['operator', 'manager', 'admin', 'superadmin'];
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isManager());
      allow update: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn();
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isManager();
    }

    match /tickets/{ticketId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOperator());
      allow write: if false; // Crítico: Apenas Cloud Functions / Backend altera tickets
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isManager());
      allow write: if false; // Crítico: Apenas Cloud Functions / Backend altera pedidos
    }

    match /payments/{paymentId} {
      allow read: if isManager();
      allow write: if false; // Crítico: Apenas Cloud Functions / Backend altera pagamentos
    }

    match /checkins/{checkinId} {
      allow read: if isOperator();
      allow write: if false; // Crítico: Apenas Cloud Functions / Backend grava checkins
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Crítico: Apenas Cloud Functions grava auditoria
    }
  }
}
