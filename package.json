{
  "name": "curitiba360-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Curitiba 360 Enterprise Edition v1.0 - Monorepo PaaS & Business OS",
  "workspaces": [
    "apps/*",
    "packages/*",
    "curitiba360-backoffice"
  ],
  "scripts": {
    "dev": "npm run dev --prefix curitiba360-backoffice",
    "build": "npm run build --prefix curitiba360-backoffice",
    "build:all": "turbo run build",
    "dev:all": "turbo run dev"
  },
  "keywords": [
    "curitiba360",
    "monorepo",
    "turborepo",
    "business-os",
    "enterprise"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "devDependencies": {
    "turbo": "^2.4.0"
  },
  "dependencies": {
    "firebase": "^12.16.0"
  }
}
